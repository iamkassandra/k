rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the document belongs to the requesting user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & settings
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Workflows collection
    match /workflows/{workflowId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || !isAuthenticated();
      allow create: if true;
      allow update, delete: if isOwner(resource.data.userId) || !isAuthenticated();
    }

    // Workflow executions & logs
    match /executions/{executionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Chat sessions and memories
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // Agent memory entries
    match /memories/{memoryId} {
      allow read, write: if true;
    }

    // Workflow catalog & templates
    match /catalog/{templateId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
